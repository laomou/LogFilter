status_dev_ended = {tool} session ended
status_dev_ended_err = {tool} session ended: {e}
status_dev_read_failed = {tool} capture failed: {e}
status_load_truncated = File load truncated by a read error: {e}
status_failed_open = Failed to open: {e}
status_failed_open_dropped = Failed to open dropped file: {e}

# quick-filter toggles
bookmarks_only = Bookmarks only
bookmarks_only_hover = Show only bookmarked lines

# clipboard / save status
status_clipboard_error = Clipboard error: {e}
status_copied_row = Copied 1 row
status_copied_rows = Copied {n} rows
status_nothing_to_save = Nothing to save
status_saved = Saved {n} lines → {path}
status_saved_incomplete = Export incomplete: {n} rows → {path} (the log was cleared or reloaded mid-export)
status_save_failed = Save failed: {e}
status_log_full = File preview memory limit reached; only part of the file is shown
status_paged_indexing = Large file opened; building disk index
status_page_not_indexed = That page has not been indexed yet
status_page_loading = Loading page {page}…
status_page_loaded = Page {page} loaded; {rows} indexed rows
status_page_failed = Paged file error: {e}
paged_utf8_only = Large-file paging currently supports UTF-8 only
status_goto_paged_filtered = Clear global filters before jumping to a source line
recording_no_overwrite = Cannot overwrite the raw recording with a filtered export
recording_export_scope = Exports recorded history using the current filters; bookmarks-only mode exports cached bookmarks.
recording_force_exit = Close now
recording_cancel_exit = Cancel exit
recording_complete = Captured
recording_incomplete = Capture failed — received data is retained in the file
recording_finishing = Finishing recording…
recording_exit_wait = Finishing disk writes and exports. Closing now may leave them incomplete; original files are never deleted.
cached_rows = cached
preview_evicted = {n} older preview rows are on disk
preview_omitted = {n} oversized rows omitted from preview; original bytes are retained in the file
status_recording_failed = Recording stopped: {e}
status_preview_failed = Preview stopped (raw recording is independent): {e}
status_preview_paused = Paused; logs received during the pause are not saved
status_preview_resumed = Resumed

# goto status
status_goto_out_of_range = Line {n} out of range (total {total})
status_goto_filtered = Line {n} is hidden by the current filter

# selection status
status_ctrl_click = Ctrl+click, selected={n}
status_shift_click = Shift+click, selected={n}
selected_n = Selected {n}
