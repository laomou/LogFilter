# formatted status messages
status_loaded = Loaded {path} — {n} lines
status_dev_started = {tool} {cmd} started
status_dev_start_failed = {tool} start failed: {e}
status_dev_stopped = {tool} stopped
status_dev_paused = {tool} paused
status_dev_resumed = {tool} resumed
