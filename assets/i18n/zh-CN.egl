# formatted status messages
status_loaded = 已加载 {path} — {n} 行
status_dev_started = {tool} {cmd} 已启动
status_dev_start_failed = {tool} 启动失败: {e}
status_dev_stopped = {tool} 已停止
status_dev_paused = {tool} 已暂停
status_dev_resumed = {tool} 已恢复
status_dev_devices = {tool} 设备: {n} 个
status_dev_devices_zero = 无设备
status_dev_devices_failed = {tool} 设备列表失败: {e}
status_dev_ended = {tool} 会话已结束
status_dev_ended_err = {tool} 会话已结束: {e}
status_dev_read_failed = {tool} 采集异常终止: {e}
status_load_truncated = 文件加载因读取错误中断: {e}
status_failed_open = 打开失败: {e}
status_failed_open_dropped = 打开拖入文件失败: {e}

# quick-filter toggles
bookmarks_only = 仅书签
bookmarks_only_hover = 只显示已加书签的行

# clipboard / save status
status_clipboard_error = 剪贴板错误: {e}
status_copied_row = 已复制 1 行
status_copied_rows = 已复制 {n} 行
status_nothing_to_save = 无内容可保存
status_saved = 已保存 {n} 行 → {path}
status_saved_incomplete = 导出不完整: 已写入 {n} 行 → {path}（日志在导出期间被清空或重载）
status_save_failed = 保存失败: {e}
status_log_full = 文件预览已达内存上限，当前只显示文件的部分内容
status_paged_indexing = 已打开大文件，正在建立磁盘索引
status_page_not_indexed = 该页尚未完成索引
status_page_loading = 正在加载第 {page} 页…
status_page_loaded = 已加载第 {page} 页，共索引 {rows} 行
status_page_failed = 分页文件错误：{e}
paged_utf8_only = 大文件分页浏览目前仅支持 UTF-8
status_goto_paged_filtered = 跳转原始行号前请先清除全局过滤

# goto status
status_goto_out_of_range = 行号 {n} 超出范围（共 {total} 行）
status_goto_filtered = 行号 {n} 已被当前过滤隐藏

# selection status
status_ctrl_click = Ctrl+点击，已选 {n} 行
status_shift_click = Shift+点击，已选 {n} 行
selected_n = 已选 {n} 行
