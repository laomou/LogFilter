recording_no_overwrite = 不能用过滤结果覆盖原始录制文件
recording_export_scope = 按当前过滤条件导出已录制的完整历史；仅书签模式导出当前缓存中的书签。
cached_rows = 缓存行数
preview_evicted = {n} 条较早日志已移出预览，仍保存在磁盘
preview_omitted = {n} 条超长日志未显示在预览中，原始内容仍完整保留在文件中
status_recording_failed = 录制已停止：{e}
status_preview_failed = 预览已停止（不影响原始录制）：{e}
status_preview_paused = 已暂停，暂停期间收到的日志不会保存
status_preview_resumed = 已恢复
line = 行
close = 关闭
select_all = 全选
